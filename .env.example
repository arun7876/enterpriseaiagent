APP_ENV=development
JWT_SECRET=
JWT_COOKIE_SECURE=false
ALLOW_SELF_SERVICE_REGISTRATION=true
ACCESS_TOKEN_TTL_MINUTES=60
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:4173,http://localhost:4173
LOG_LEVEL=INFO
DATA_DIR=data
AUTH_DB_PATH=data/auth.sqlite3
DOCUMENT_CATALOG_PATH=data/documents.sqlite3
UPLOAD_DIR=data/uploads
RAG_INDEX_PATH=data/index/vector_index.sqlite3
BUSINESS_DB_PATH=data/business_analytics.sqlite3
HF_HOME=data/models/huggingface
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:0.5b
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
MAX_UPLOAD_SIZE_BYTES=10485760
RAG_MIN_RELEVANCE_SCORE=0.30
OLLAMA_TIMEOUT_SECONDS=90
VITE_API_BASE_URL=http://127.0.0.1:8000
